# Build output
.gradle/
.gradle-cache/
build/

# Signing keys — never commit these
*.jks
*.keystore

# Built artifacts
*.apk
*.aab
*.aar

# Tools and JDK downloaded by make.sh
cmdline-tools/
jvm/
local.properties

# Generated from `scripts = ...` during apply_config
app/src/main/assets/userscripts/

# Generated from `site = ...` during apply_config
app/src/main/assets/site/

# IDE
*.iml
.idea/
.vscode/

# Pi workspace (contains session/auth data)
.pi-box/

# Agent instructions, kept local only
AGENTS.md

# Local per-app configs and icons. Uncomment to keep them out of git:
# confs/
